<!--
  local_decoder.xml — Decoder para los logs del firewall perimetral (fw-gateway).
  nftables registra las conexiones nuevas con prefijo "FW-NEW-CONN: ", "FW-SYN: "
  o "FW-FWD: " seguido del formato netfilter estandar (IN= ... SRC= DST= ...
  PROTO=TCP SPT= DPT=). Este decoder extrae srcip/dstip/dstport para que las
  reglas de correlacion (p.ej. 100022, escaneo sigiloso) puedan agrupar por
  origen. Colocar en /var/ossec/etc/decoders/local_decoder.xml y reiniciar.
-->
<decoder name="fw-gateway">
  <prematch>FW-NEW-CONN: |FW-SYN: |FW-FWD: </prematch>
</decoder>

<decoder name="fw-gateway-fields">
  <parent>fw-gateway</parent>
  <regex type="pcre2">SRC=(\S+)\s+DST=(\S+).*?DPT=(\d+)</regex>
  <order>srcip,dstip,dstport</order>
</decoder>
